{
  "name": "sqslearn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run test && npm run build && playwright test",
    "bench": "vitest run --config bench/vitest.config.ts",
    "bench:render": "npm run build && playwright test -c bench/playwright.config.ts --reporter=list"
  },
  "dependencies": {
    "preact": "^11.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
